# Production configuration. Set these in your hosting service, not in GitHub source.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PORTAL_ORIGIN=https://your-portal-domain.example
# On Render this can be omitted: the app uses RENDER_EXTERNAL_URL automatically.
DATABASE_PATH=/app/data/portal.sqlite
# Optional: supply a long random bootstrap token via your host's secret settings.
# Otherwise a token is generated and printed to the server console before setup.
# SETUP_TOKEN=
